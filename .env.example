# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit secrets.
# The app validates these vars with Zod at boot and crashes with a clear
# error if either one is missing or malformed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Feature flag: mobile-first responsive navigation shell.
# Set to 'true' to enable BottomNav (mobile), SideNavCompact (tablet),
# and SideNavFull (web) in place of the legacy AppBar-only layout.
# Set to 'false' (or omit) to keep the known-good legacy shell.
VITE_FLAG_MOBILE_UX=false
