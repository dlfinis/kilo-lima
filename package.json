{
  "name": "kilo-lima",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA personal para gestión de costos y ventas en ferias (costos de producción, eventos, POS, análisis).",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "localforage": "^1.10.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "vuetify": "^3.12.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.5"
  }
}
